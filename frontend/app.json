{
  "expo": {
    "name": "attendX",
    "slug": "attendx",
    "version": "1.0.0",
    "scheme": "ai-attendance",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.attendx.app"
    },
    "android": {
      "package": "com.attendx.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "76f66aa3-5726-42b2-ba58-e7083f18d5ac"
      }
    },
    "owner": "kessuuu"
  }
}
